#include <iostream>
using namespace std;

int main()
{
    int a[3][3], i, j;

    cout << "Enter 9 elements for a 3x3 matrix:\n";
    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            cin >> a[i][j];
        }
    }

    cout << "\nMatrix is:\n";
    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            cout << a[i][j] << "\t";
        }
        cout << endl;
    }

    return 0;
}
