#include <iostream>
using namespace std;

int main()
{
    int a[2][2][2][2][2];
    int i, j, k, l, m;

    cout << "Enter 32 values:\n";
    for (i = 0; i < 2; i++)
        for (j = 0; j < 2; j++)
            for (k = 0; k < 2; k++)
                for (l = 0; l < 2; l++)
                    for (m = 0; m < 2; m++)
                        cin >> a[i][j][k][l][m];

    cout << "\nArray elements are:\n";
    for (i = 0; i < 2; i++)
        for (j = 0; j < 2; j++)
            for (k = 0; k < 2; k++)
                for (l = 0; l < 2; l++)
                {
                    for (m = 0; m < 2; m++)
                        cout << "a[" << i << "][" << j << "][" << k << "][" << l << "][" << m << "] = "
                             << a[i][j][k][l][m] << "  ";
                    cout << "\n";
                }

    return 0;
}
